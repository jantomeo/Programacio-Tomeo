            print("La resta és: ", str(n2-n1))

elif operacio=="multiplicació":
      print("La multiplicació és:", str(n1*n2))

elif operacio=="divisió":
    if n2==0:
        print("No es pot dividir entre 0")
        
    opcion = input(f"Vols fer (\"{n1}/{n2}\") o (\"{n2}/{n1}\")? Escriu \"{n1}/{n2}\" o \"{n2}/{n1}\": ")
    if opcion==f"{n1}/{n2}":
        print("La divisió és: ", str(n1/n2))
    else:
        print("La divisió és: ", str(n2/n1))

elif operacio=="potencia":
    opcion = input(f"Vols fer (\"{n1**2}\") o (\"{n2**2}\")? Escriu \"{n1**2}\" o \"{n2**2}\": ")
    if opcion==f"{n1**2}":
        print("El primer número elevat a la potència és: ", str(n1**2))
    else:
        print("El segon número elevat a la potència és: ", str(n2**2))

elif operacio=="modul":
    if n2==0:
        print("No es pot calcular el mòdul entre 0")
    opcion = input(f"Vols fer (\"{n1%n2}\") o (\"{n2%n1}\")? Escriu \"{n1%n2}\" o \"{n2%n1}\": ")
    if opcion==f"{n1%n2}":
        print("El mòdul és: ", str(n1%n2))
    else:
        print("El mòdul és: ", str(n2%n1))

elif operacio=="divisio entera":
    if n2==0:
        print("No es pot fer la divisió entera entre 0")
    opcion = input(f"Vols fer (\"{n1//n2}\") o (\"{n2//n1}\")? Escriu \"{n1//n2}\" o \"{n2//n1}\": ")
    if opcion==f"{n1//n2}":
        print("La divisió entera és: ", str(n1//n2))
    else:
        print("La divisió entera és: ", str(n2//n1))

else: print("Operació no vàlida")