suma=n1+n2

print("")


operacio=input("Que vols fer amb aquests numeros? Escriu 'suma', 'resta', 'multiplicació' , 'divisió' , 'potencia' , 'modul' o 'divisio entera': ")

if operacio=="suma":

   opcion = input(f"Vols fer ({n1}+{n2}) o ({n2}+{n1})? Escriu \"{n1}+{n2}\" o \"{n2}+{n1}\": ")
   if opcion==f"{n1}+{n2}":
            print("La suma és: ", str(n1+n2))
   else:
            print("La suma és: ", str(n2+n1))

elif operacio=="resta":
        opcion = input(f"Vols fer ({n1}-{n2}) o ({n2}-{n1})? Escriu \"{n1}-{n2}\" o \"{n2}-{n1}\": ")
        if opcion==f"{n1}-{n2}":
